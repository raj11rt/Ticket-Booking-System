# Ticket Booking System Environment Configuration

# Database URL
# SQLite default for local development:
DATABASE_URL=sqlite:///./ticket_booking.db
# PostgreSQL for production/hosting:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# JWT Auth Secret Key (Change this in production!)
SECRET_KEY=3db2694b2ca52e90c8a81615dcd5fa37e6f8fa3023da56291a18d1847e3a985e
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seat hold duration before automatic release (in minutes)
SEAT_HOLD_TTL_MINUTES=10

# Waitlist offer claim duration before automatically expiring and passing to next (in minutes)
WAITLIST_OFFER_TTL_MINUTES=5

# Email Configuration
# Set to "console" to log premium HTML emails locally to the `sent_emails/` folder (great for testing)
# Set to "resend" to send real emails via Resend API
EMAIL_PROVIDER=console
RESEND_API_KEY=re_123456789
FROM_EMAIL=onboarding@resend.dev

# Frontend Base URL (used for links in emails, e.g. Vercel deployment URL)
FRONTEND_URL=http://localhost:8000
